{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiecp.dev/schema/evidence/incident.schema.json",
  "title": "Incident",
  "description": "Something diverged from expected behavior. The root artifact that anchors a debugging chain (see docs/evidence-model.md).",
  "type": "object",
  "required": ["id", "observed_at", "environment_fingerprint_ref", "expected_ref", "actual_ref", "severity", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^incident-[a-zA-Z0-9_-]+$" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "observed_at": { "type": "string", "format": "date-time" },
    "reported_by": {
      "type": "string",
      "enum": ["user", "agent", "test_suite", "monitoring"],
      "description": "Who/what first surfaced this incident."
    },
    "summary": { "type": "string", "maxLength": 500 },
    "environment_fingerprint_ref": { "type": "string" },
    "expected_ref": { "type": "string" },
    "actual_ref": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "status": {
      "type": "string",
      "enum": ["open", "reproducing", "diagnosing", "fix-proposed", "fix-applied", "verified", "closed", "wontfix"]
    },
    "trace_refs": { "type": "array", "items": { "type": "string" } },
    "decision_refs": { "type": "array", "items": { "type": "string" } },
    "regression_of": {
      "type": ["string", "null"],
      "description": "If set, references a prior Incident id this is a Regression of."
    }
  },
  "additionalProperties": false
}
