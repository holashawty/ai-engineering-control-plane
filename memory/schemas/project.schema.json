{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiecp.dev/schema/memory/project.schema.json",
  "title": "Project memory",
  "description": "What this project is. Set on onboarding, versioned on structural change. See docs/memory-model.md.",
  "type": "object",
  "required": ["id", "type", "created_at", "source", "schema_version", "stack", "layer"],
  "properties": {
    "id": { "type": "string", "pattern": "^mem-project-[a-zA-Z0-9_-]+$" },
    "type": { "type": "string", "const": "project" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "source": { "type": "string", "description": "Which discovery run / decision produced this entry." },
    "stack": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. ['python', 'typescript'] — languages/runtimes detected."
    },
    "layer": {
      "type": "array",
      "items": { "type": "string", "enum": ["backend", "frontend", "mobile", "desktop", "cli", "api", "database", "monorepo"] }
    },
    "domain": { "type": "string", "description": "One-line description of what the project does." }
  },
  "additionalProperties": false
}
